<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>offboard_mission</name>
  <version>0.0.0</version>
  <description>Autonomous PX4 offboard mission: arm, take off, fly to a waypoint, scan for a safe landing point with segmentation_node/landing_circle, and land on it.</description>
  <maintainer email="agungfirmansyahdjalil@gmail.com">alphaone</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>px4_offboard_lib</exec_depend>
  <!-- The mission reads the landing target off the dynamic TF
       map -> safety_point broadcast by segmentation_node/landing_circle. -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
