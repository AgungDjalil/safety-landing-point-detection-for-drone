<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_bridge_ros2</name>
  <version>0.1.0</version>
  <description>
    ROS 2 launch + bridge for the PX4 Gazebo (gz) x500_depth depth camera.
    Bridges the Gazebo depth-camera topics (/depth_camera, /depth_camera/points)
    from the OakD-Lite sensor of the x500_depth model into ROS 2
    (sensor_msgs/Image, sensor_msgs/PointCloud2), and launches the microXRCE-DDS
    agent together with PX4 SITL (`make px4_sitl gz_x500_depth`).
  </description>

  <maintainer email="dev@example.com">PX4-Autopilot</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- drone_kinematic node (compiles C++) -->
  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- launch + bridges (runtime only) -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Nodes this launch starts from other packages: the plane-segmentation
       front-ends selected by `perception`, and the trajectory trail. -->
  <exec_depend>gng_node</exec_depend>
  <exec_depend>segmentation_node</exec_depend>
  <exec_depend>path_trail</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>