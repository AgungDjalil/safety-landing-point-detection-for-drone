<?xml version="1.0" encoding="UTF-8"?>
<!--
  forest_x4.sdf — forest scene rebuilt from luispinto's "Forest with X4 hexarotor"
  Fuel world (https://app.gazebosim.org/luispinto/fuel/worlds/Forest%20with%20X4%20hexarotor).

  The original world referenced a private local model DB (file:///models_database/...) that
  does not exist outside the author's machine, embedded a non-PX4 X4 hexarotor with a
  velocity-control plugin, and used Fortress-era ignition-gazebo-* system plugins.

  This file keeps luispinto's tree/grass LAYOUT but:
    - strips the embedded hexarotor (PX4 spawns gz_x500_depth itself at runtime)
    - strips warehouse clutter (pallets/boxes/shelf/lion/trashcan)
    - rewrites broken local URIs to valid Fuel URIs (same as PX4 worlds/forest.sdf):
        Oak Tree  -> OpenRobotics/Oak Tree
        Pine Tree -> OpenRobotics/Pine Tree
        grass    -> hexarotor/grasspatch
    - adds a ground_plane at z=-0.05 (original had none; offset avoids Z-fighting
      with the z=0 grasspatch visuals)
    - omits inline system <plugin> blocks (PX4 loads systems via server.config,
      see gz_env.sh.in GZ_SIM_SERVER_CONFIG_PATH; inline plugins would break startup)
    - uses PX4 Zurich spherical coordinates + magnetic field for SITL consistency

  Usage:  PX4_GZ_WORLD=forest_x4 make px4_sitl gz_x500_depth
          (or: make px4_sitl gz_x500_depth_forest_x4  after a CMake reconfigure)
-->
<sdf version="1.9">
  <world name="forest_x4">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 -0.05 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ================================================================== -->
    <!-- Central objects: collapsed house + warehouse clutter                -->
    <!-- ================================================================== -->
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Collapsed House</uri>
      <name>Collapsed House</name>
      <pose>0 8 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/Abdurrahman/models/aws_robomaker_warehouse_ClutteringC_01</uri>
      <name>warehouse_ClutteringC_01</name>
      <pose>5 -2.8 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/Abdurrahman/models/aws_robomaker_warehouse_ClutteringC_01</uri>
      <name>warehouse_ClutteringC_02</name>
      <pose>3.8 -1.8 0 0 -0 0</pose>
